{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/../companion/bin/tilt-signal\" working --json",
            "name": "tilt-working",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/../companion/bin/tilt-signal\" idle --json",
            "name": "tilt-idle",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/../companion/bin/tilt-signal\" idle --json",
            "name": "tilt-session-end",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
