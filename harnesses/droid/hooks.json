{
  "UserPromptSubmit": [
    {
      "hooks": [
        { "type": "command", "command": "<TILT_DIR>/harnesses/companion/bin/tilt-signal working", "timeout": 5 }
      ]
    }
  ],
  "Stop": [
    { "hooks": [{ "type": "command", "command": "<TILT_DIR>/harnesses/companion/bin/tilt-signal idle", "timeout": 5 }] }
  ],
  "Notification": [
    {
      "matcher": "idle_prompt",
      "hooks": [{ "type": "command", "command": "<TILT_DIR>/harnesses/companion/bin/tilt-signal idle", "timeout": 5 }]
    }
  ],
  "SessionEnd": [
    { "hooks": [{ "type": "command", "command": "<TILT_DIR>/harnesses/companion/bin/tilt-signal idle", "timeout": 5 }] }
  ]
}
